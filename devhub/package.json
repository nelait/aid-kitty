{
  "name": "devhub",
  "version": "0.1.0",
  "private": true,
  "description": "Dev Hub control plane: one AI budget wallet across Claude and GitHub Copilot, with approvals and chargeback.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "license": "tsx scripts/license.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1161.0",
    "@aws-sdk/client-license-manager": "^3.1161.0",
    "@google-cloud/compute": "^7.9.0",
    "express": "^4.22.3",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8"
  }
}
