{
  "name": "devhub",
  "version": "0.1.0",
  "private": true,
  "description": "Dev Hub control plane: one AI budget wallet across Claude and GitHub Copilot, with approvals and chargeback.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "license": "tsx scripts/license.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8"
  }
}
